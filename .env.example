# SEGS — Environment Variables Reference
# Copy this file to .env (local dev) or load into AWS Secrets Manager (production).
# Lines marked REQUIRED must be set. Lines marked OPTIONAL can be omitted to use
# the default shown. Never commit your actual .env to git.

# ── Core ─────────────────────────────────────────────────────────────────────

# Enforcement mode: shadow (log-only), quarantine (hold mail), reject (hard-block)
# Start with shadow for monitoring. Switch to quarantine after tuning.
SEG_ENFORCE=shadow                          # REQUIRED

# Set to 1 when running behind HTTPS (ALB/CloudFront). Enables Secure cookie flag + HSTS.
SEG_COOKIE_SECURE=1                         # REQUIRED in production

# Public console URL (scheme + host). Required for passkeys behind CloudFront/ALB.
# Example: https://dxxxxx.cloudfront.net
# SEG_PUBLIC_ORIGIN=https://your-console-host

# API serves the Svelte console from web-console/dist when 1 (local default).
# Production CloudFront serves the SPA from S3 — Fargate sets this to 0.
# SEG_SERVE_SPA=1

# Include scored demo .eml rows on GET /api/feed. Off by default when
# SEG_DATABASE_URL is set (production = copies SELECT only).
# SEG_DASHBOARD_SAMPLES=0

# Absolute path to the quarantine spool directory (filesystem backend).
# In Docker this is still used when SEG_S3_BUCKET is empty (pytest / local).
# Production ECS writes .eml objects to the CMK-encrypted mail bucket instead.
SEG_QUARANTINE_ROOT=/opt/segs/email/spool  # REQUIRED in production unless S3 spool is set

# ── Gmail API (Path A — post-delivery scanning, Abnormal-style) ──────────
# Workspace admin registers this service account's Client ID under
# Admin console → Security → API controls → Domain-wide delegation
# with scope https://www.googleapis.com/auth/gmail.readonly
# SEGS then *calls* Gmail (outbound poll). No Pub/Sub push URL is required.

# Path to the GCP service-account JSON file.
# In ECS: leave as default (/opt/segs/credentials.json) — entrypoint.sh writes
# the file from SEGS_GMAIL_CREDENTIALS_JSON (see below).
SEG_GMAIL_CREDENTIALS=/opt/segs/credentials.json   # REQUIRED

# Contents of credentials.json as a single-line JSON string.
# Store this in AWS Secrets Manager. entrypoint.sh writes it to SEG_GMAIL_CREDENTIALS.
# Generate: python3 -c "import json,sys; print(json.dumps(json.load(open('credentials.json'))))"
SEGS_GMAIL_CREDENTIALS_JSON=                        # REQUIRED in ECS (replaces the file)

# Google Workspace primary domain.
SEG_GMAIL_DOMAIN=pdax.ph                    # REQUIRED

# Comma-separated list of Gmail mailboxes to impersonate and poll.
SEG_GMAIL_USERS=security@pdax.ph,pat@pdax.ph   # REQUIRED

# How often the receiver polls Gmail history (seconds).
SEG_GMAIL_POLL_SECONDS=30

# Unused in poll mode (kept so older .env files still load).
# SEG_GMAIL_TOPIC=
# SEG_PUBSUB_TOKEN=

# How long one Gmail LLM *attempt* may run (from worker start, not enqueue).
SEG_LLM_ASSESS_TIMEOUT_SECONDS=120
# Per-Vertex-slot HTTP timeout so the GLM/Kimi/Gemini cascade can still run.
SEG_LLM_MODEL_TIMEOUT_SECONDS=25

# Background workers (in-process threads; Docker/ECS default on).
# Profile ingest and campaign clustering run in API + receiver.
# Inconclusive retry + Gmail poll run in the receiver container.
# Dashboard status: split workers expose :8766/health over TLS. In ECS the API
# probes the internal workers ALB (SEG_WORKER_HEALTH_BASE_URL, https). Locally
# the API uses file/Postgres heartbeats if this is unset.
# SEG_WORKER_HEALTH_BASE_URL=https://segs-prod-workers.internal
# SEG_WORKER_HEALTH_PORT=8766
SEG_PROFILE_WORKER=1
SEG_PROFILE_WORKER_SECONDS=45
SEG_CAMPAIGN_WORKER=1
SEG_CAMPAIGN_WORKER_SECONDS=90
SEG_SENDER_RISK_WORKER=1
SEG_SENDER_RISK_SECONDS=60
SEG_SENDER_RISK_BATCH=5
SEG_INCONCLUSIVE_RETRY=1
SEG_INCONCLUSIVE_RETRY_SECONDS=30
SEG_INCONCLUSIVE_RETRY_BATCH=25
SEG_INCONCLUSIVE_RETRY_MAX=12
# Worker pool sizes (per container). Production split tasks set these in Terraform.
SEG_STATIC_WORKERS=2
SEG_INTEL_WORKERS=1
SEG_CONTENT_AI_WORKERS=4
SEG_THREAD_AI_WORKERS=1
SEG_PROFILE_WORKERS=4
SEG_SENDER_RISK_WORKERS=2
SEG_JOB_LEASE_SECONDS=360
SEG_JOB_MAX_ATTEMPTS=8
SEG_GMAIL_FETCH_WORKERS=4
SEG_LLM_BACKFILL_LIMIT=200
# Set 0 on the all-in-one receiver when poll/static/AI run as separate containers.
# SEG_INLINE_WORKERS=1
# docker compose: http://receiver:8766/health
# local two-process: http://127.0.0.1:8766/health (default)
# SEG_RECEIVER_HEALTH_URL=http://127.0.0.1:8766/health
SEG_CORRELATION_STORE=1

# Provider: heuristic (offline, no AI), glm, bedrock, gemini, ollama
SEG_CONTENT_PROVIDER=glm                    # REQUIRED

# Vertex AI Model Garden — cascade order is GLM 5.2 → Gemini Flash → Kimi → DeepSeek R1
# (DeepSeek is last: slow reasoning model that often burns the per-slot timeout).
SEG_GLM_MODEL_ID=deepseek-ai/deepseek-r1-0528-maas  # last-resort slot if SEG_CONTENT_PROVIDER=glm
SEG_GLM_LOCATION=us-central1
SEG_GLM_PROJECT_ID=REPLACE_ME              # REQUIRED if using GCP service-account auth
SEG_GLM_API_KEY=                           # REQUIRED if using API key auth (alternative to credentials.json)
SEG_GLM_CREDENTIALS_PATH=/opt/segs/credentials.json   # REQUIRED if using service-account auth

# LLM cascade (tried in this order — GLM first, DeepSeek last)
SEG_GLM_FALLBACK1_MODEL_ID=zai-org/glm-5.2-maas
SEG_GLM_FALLBACK1_LOCATION=global
SEG_GLM_FALLBACK2_MODEL_ID=moonshotai/kimi-k3-maas
SEG_GLM_FALLBACK2_LOCATION=global
SEG_GLM_FALLBACK3_MODEL_ID=google/gemini-2.5-flash
SEG_GLM_FALLBACK3_LOCATION=us-central1

# ── Threat Intelligence ───────────────────────────────────────────────────

# Provider: local (no external lookups), vt_abuseipdb (VirusTotal + AbuseIPDB)
SEG_INTEL_CLIENT=vt_abuseipdb              # REQUIRED for live intel

# VirusTotal free-tier API key — https://www.virustotal.com/gui/my-apikey
SEG_VT_API_KEY=REPLACE_ME                  # REQUIRED if SEG_INTEL_CLIENT=vt_abuseipdb

# AbuseIPDB free-tier API key — https://www.abuseipdb.com/account/api
SEG_ABUSEIPDB_API_KEY=REPLACE_ME           # REQUIRED if SEG_INTEL_CLIENT=vt_abuseipdb

# ── SMTP Notifications ────────────────────────────────────────────────────

# SMTP password for segs-alerts@pdax.ph. Use a Google Workspace App Password.
# Configure in dashboard Settings → Quarantine Notification.
SEGS_NOTIFY_SMTP_PASS=REPLACE_ME           # REQUIRED to enable quarantine notifications

# ── Optional Enrichments ──────────────────────────────────────────────────

# Set to 1 to follow links in emails and inspect landing pages (SSRF-guarded).
# Enable only from an isolated egress (not directly from the production VPC).
SEG_LANDING_FETCH=1                        # OPTIONAL (default: disabled)

# Set to 1 to perform live RDAP lookups for domain age/registrar and for
# originating-IP network records (https://rdap.org/ip/{ip}).
SEG_RDAP_LOOKUP=1                          # OPTIONAL (default: disabled)

# Gemini Google Search grounding for originating-IP OSINT. Separate from
# content analysis (schema-bound generate_content cannot mix with search).
# GLM / DeepSeek / Kimi cannot search; this extra call runs only when a
# Gemini API key is set. Sends IP + hostname only, never the message body.
# Default on; set 0 to skip.
# SEG_ORIGIN_IP_SEARCH=1

# City / ISP / ASN / proxy-hosting lookup for the originating IP (ip-api.com).
# Default on. Set 0 to skip the extra HTTP call.
# SEG_ORIGIN_IP_GEO=1

# Extra ISO country codes treated as expected origin (comma-separated), on top
# of the sender ccTLD (.ph → PH) and usual Google/Microsoft/ESP hubs.
# SEG_EXPECTED_MAIL_COUNTRIES=PH

# Enable LLM-assisted verdict triage (reduces false positives near score thresholds).
SEG_LLM_TRIAGE=1                          # OPTIONAL (default: disabled)

# ── AWS ───────────────────────────────────────────────────────────────────

# AWS region (SQS, S3, KMS, Bedrock). ECS tasks use the task role — do not
# put AWS_ACCESS_KEY_ID in Secrets Manager.
AWS_REGION=ap-southeast-1

# Mail spool bucket (SSE-KMS with the project CMK). Empty = filesystem spool.
# Terraform writes this into the infra secret as SEG_S3_BUCKET.
# SEG_S3_BUCKET=
# SEG_KMS_KEY_ARN=
# SEG_DATABASE_URL=postgresql://segs:…@aurora-endpoint:5432/segs
# SEG_SQS_STATIC_URL=
# SEG_SQS_CONTENT_AI_URL=
# SEG_SQS_THREAD_AI_URL=
# SEG_SQS_CAMPAIGN_URL=
# SEG_SQS_PROFILE_URL=

# ── ClamAV / Virtual Analyzer (optional — defense-in-depth AV scan layer) ─
#
# ClamAV adds a signature-based AV scan on top of the existing static forensics.
# Static forensics runs unconditionally; ClamAV is purely additive.
# Requirements: pip install pyclamd + a running clamd daemon on the host/sidecar.
# Leave SEG_SANDBOX_PROVIDER unset (or =null) to keep existing behavior unchanged.
# See docs/configuration.md §Defense in Depth for full setup notes.
#
# SEG_SANDBOX_PROVIDER=clamav    # set to "clamav" to enable; default is "null" (no-op)
# SEG_CLAMD_HOST=localhost        # clamd host (ignored when SEG_CLAMD_SOCKET is set)
# SEG_CLAMD_PORT=3310             # clamd TCP port (default: 3310)
# SEG_CLAMD_SOCKET=               # Unix socket path, e.g. /var/run/clamav/clamd.ctl (preferred over TCP)

# ── JumpCloud SSO (planned future — leave empty to disable) ───────────────
#
# The platform is SSO-ready. Admins store JumpCloud OIDC values under
# Settings → Users & SSO. Live enforcement still needs SEG_SSO_PROVIDER=alb_oidc
# and the ALB authenticate-OIDC action. See docs/jumpcloud-sso.md.
#
# SEG_SSO_PROVIDER=                      # set to "alb_oidc" to enable
# SEG_OIDC_CLIENT_ID=                    # JumpCloud OIDC app client ID
# SEG_OIDC_CLIENT_SECRET=                # JumpCloud OIDC app client secret
# SEG_OIDC_ISSUER=https://oauth.id.jumpcloud.com

# Stateful JWT signing key (HS256). Empty uses a built-in dev fallback — set in
# production (Terraform writes this into the infra secret).
# SEG_JWT_SECRET=
# SEG_JWT_ISSUER=segs

# SCIM 2.0 bearer token for JumpCloud (or any RFC 7644 client) at /scim/v2.
# Terraform stores this in the infra secret as SEG_SCIM_BEARER_TOKEN.
# SEG_SCIM_BEARER_TOKEN=

# ── S3 / Wazuh SIEM Integration (optional) ────────────────────────────────
#
# When SEG_S3_BUCKET is set, a background thread ships both JSONL audit logs
# (data/activity_audit.jsonl and email/spool/shadow_logs/shadow_enforcement.jsonl)
# to S3 in gzip-compressed batches that Wazuh's S3 input module can ingest.
# Shipped records are tagged "wazuh": true, activating the dashboard's
# "Wazuh alerts only" feed filter.
# Credentials come from the ECS task role (IAM instance profile) — no stored keys.
# Leave SEG_S3_BUCKET empty (the default) to disable shipping entirely.
#
# SEG_S3_BUCKET=                  # S3 bucket name; empty = shipper disabled (default)
# SEG_S3_PREFIX=segs/logs         # S3 key prefix (default: segs/logs)
# SEG_S3_REGION=ap-southeast-1    # S3 region (default: AWS_REGION, then ap-southeast-1)
# SEG_S3_SHIP_INTERVAL=60         # flush interval in seconds (default: 60)

# ── Tuning / Performance ───────────────────────────────────────────────────
#
# These control timeout and rate-limit behaviour for the pipeline. The defaults
# are chosen to handle emails with many attachments (up to 8 fresh VT lookups
# × 15 s throttle = 120 s) while leaving headroom for PDF/archive forensics
# and LLM calls. Raise SEG_ANALYZE_TIMEOUT_SECONDS if VT is disabled or the
# cache is already warm (most lookups are cached after a few hours of traffic).
#
# SEG_ANALYZE_TIMEOUT_SECONDS=300       # per-phase timeout for EML upload analysis (default: 300)
# SEG_EMAIL_SCAN_TIMEOUT_SECONDS=300    # per-email timeout for live Gmail API scanning (default: 300)
# SEG_VT_MAX_INDICATORS_PER_EMAIL=8     # max fresh (non-cached) VT/AbuseIPDB calls per email (default: 8)
# SEG_VT_TIME_BUDGET_SECONDS=90         # hard wall-clock cap on the entire VT/AbuseIPDB intel stage
#                                        # per email (default: 90). Indicators not checked within this
#                                        # window are skipped. Raise to 180 with a paid VT tier.
