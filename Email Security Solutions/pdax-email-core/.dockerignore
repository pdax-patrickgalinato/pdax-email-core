# Python runtime artifacts
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Secrets — never bake into the image
.env
.env.*
credentials.json
*-service-account.json
*.pem
*.key

# Sensitive runtime data — mounted via EFS in production
data/
gateway/spool/

# Dev/test artifacts
.claude/
.git/
.gitignore
tests/
samples/
samples_output/

# Docs (reduce image size)
docs/
*.md

# Claude Code state
*.jsonl
