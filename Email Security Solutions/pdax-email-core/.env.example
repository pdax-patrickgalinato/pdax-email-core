# SEGS — Environment Variables Reference
# Copy this file to .env (local dev) or load into AWS Secrets Manager (production).
# Lines marked REQUIRED must be set. Lines marked OPTIONAL can be omitted to use
# the default shown. Never commit your actual .env to git.

# ── Core ─────────────────────────────────────────────────────────────────────

# Enforcement mode: shadow (log-only), quarantine (hold mail), reject (hard-block)
# Start with shadow for monitoring. Switch to quarantine after tuning.
SEG_ENFORCE=shadow                          # REQUIRED

# Set to 1 when running behind HTTPS (ALB/nginx). Enables Secure cookie flag + HSTS.
SEG_COOKIE_SECURE=1                         # REQUIRED in production

# Absolute path to the quarantine spool directory.
# In Docker/ECS this must be an absolute path (EFS mount point).
SEG_QUARANTINE_ROOT=/opt/segs/gateway/spool  # REQUIRED in production

# ── Gmail API (Path A — post-delivery scanning) ────────────────────────────

# Path to the GCP service-account JSON file.
# In ECS: leave as default (/opt/segs/credentials.json) — entrypoint.sh writes
# the file from SEGS_GMAIL_CREDENTIALS_JSON (see below).
SEG_GMAIL_CREDENTIALS=/opt/segs/credentials.json   # REQUIRED

# Contents of credentials.json as a single-line JSON string.
# Store this in AWS Secrets Manager. entrypoint.sh writes it to SEG_GMAIL_CREDENTIALS.
# Generate: python3 -c "import json,sys; print(json.dumps(json.load(open('credentials.json'))))"
SEGS_GMAIL_CREDENTIALS_JSON=                        # REQUIRED in ECS (replaces the file)

# Full Pub/Sub topic name. Get from GCP console.
# Format: projects/<gcp-project-id>/topics/<topic-name>
SEG_GMAIL_TOPIC=projects/REPLACE_ME/topics/segs-gmail   # REQUIRED

# Google Workspace primary domain.
SEG_GMAIL_DOMAIN=pdax.ph                    # REQUIRED

# Comma-separated list of Gmail mailboxes to monitor.
SEG_GMAIL_USERS=security@pdax.ph,pat@pdax.ph   # REQUIRED

# Shared secret to validate Pub/Sub push requests.
# Set the same value in the GCP Pub/Sub push subscription "Authentication" field.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SEG_PUBSUB_TOKEN=REPLACE_ME_STRONG_RANDOM_TOKEN   # REQUIRED

# ── Content AI ────────────────────────────────────────────────────────────

# Provider: heuristic (offline, no AI), glm, bedrock, gemini, ollama
SEG_CONTENT_PROVIDER=glm                    # REQUIRED

# GLM (Zhipu/Z.ai via Vertex AI Model Garden) — primary provider
SEG_GLM_MODEL_ID=zai-org/glm-4.7-maas      # REQUIRED if SEG_CONTENT_PROVIDER=glm
SEG_GLM_LOCATION=global
SEG_GLM_PROJECT_ID=REPLACE_ME              # REQUIRED if using GCP service-account auth
SEG_GLM_API_KEY=                           # REQUIRED if using API key auth (alternative to credentials.json)
SEG_GLM_CREDENTIALS_PATH=/opt/segs/credentials.json   # REQUIRED if using service-account auth

# GLM cascade fallbacks (tried in order if primary fails)
SEG_GLM_FALLBACK1_MODEL_ID=zai-org/glm-5-maas
SEG_GLM_FALLBACK2_MODEL_ID=moonshotai/kimi-k3-maas
SEG_GLM_FALLBACK2_LOCATION=global
SEG_GLM_FALLBACK3_MODEL_ID=google/gemini-2.5-flash
SEG_GLM_FALLBACK3_LOCATION=us-central1

# ── Threat Intelligence ───────────────────────────────────────────────────

# Provider: local (no external lookups), vt_abuseipdb (VirusTotal + AbuseIPDB)
SEG_INTEL_CLIENT=vt_abuseipdb              # REQUIRED for live intel

# VirusTotal free-tier API key — https://www.virustotal.com/gui/my-apikey
SEG_VT_API_KEY=REPLACE_ME                  # REQUIRED if SEG_INTEL_CLIENT=vt_abuseipdb

# AbuseIPDB free-tier API key — https://www.abuseipdb.com/account/api
SEG_ABUSEIPDB_API_KEY=REPLACE_ME           # REQUIRED if SEG_INTEL_CLIENT=vt_abuseipdb

# ── SMTP Notifications ────────────────────────────────────────────────────

# SMTP password for segs-alerts@pdax.ph. Use a Google Workspace App Password.
# Configure in dashboard Settings → Quarantine Notification.
SEGS_NOTIFY_SMTP_PASS=REPLACE_ME           # REQUIRED to enable quarantine notifications

# ── Optional Enrichments ──────────────────────────────────────────────────

# Set to 1 to follow links in emails and inspect landing pages (SSRF-guarded).
# Enable only from an isolated egress (not directly from the production VPC).
SEG_LANDING_FETCH=1                        # OPTIONAL (default: disabled)

# Set to 1 to perform live RDAP lookups for domain age/registrar.
SEG_RDAP_LOOKUP=1                          # OPTIONAL (default: disabled)

# Enable LLM-assisted verdict triage (reduces false positives near score thresholds).
SEG_LLM_TRIAGE=1                          # OPTIONAL (default: disabled)

# ── AWS ───────────────────────────────────────────────────────────────────

# AWS region for Bedrock (only needed if SEG_CONTENT_PROVIDER=bedrock)
AWS_REGION=ap-southeast-1

# ── JumpCloud SSO (planned future — leave empty to disable) ───────────────
#
# The platform is SSO-ready. Set SEG_SSO_PROVIDER=alb_oidc and redeploy to
# activate. The ALB handles JumpCloud OIDC token validation; SEGS just trusts
# the x-amzn-oidc-identity header the ALB injects.
# See docs/JUMPCLOUD_SSO.md for step-by-step activation.
#
# SEG_SSO_PROVIDER=                      # set to "alb_oidc" to enable
# SEG_OIDC_CLIENT_ID=                    # JumpCloud OIDC app client ID
# SEG_OIDC_CLIENT_SECRET=                # JumpCloud OIDC app client secret
# SEG_OIDC_ISSUER=https://oauth.id.jumpcloud.com
