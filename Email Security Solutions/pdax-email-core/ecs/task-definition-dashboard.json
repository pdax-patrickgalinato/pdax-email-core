{
  "family": "segs-dashboard",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::REPLACE_AWS_ACCOUNT_ID:role/segs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::REPLACE_AWS_ACCOUNT_ID:role/segs-task-role",
  "containerDefinitions": [
    {
      "name": "segs-dashboard",
      "image": "REPLACE_AWS_ACCOUNT_ID.dkr.ecr.ap-southeast-1.amazonaws.com/pdax/segs:dashboard-latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8765,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SEG_ENFORCE",          "value": "shadow" },
        { "name": "SEG_COOKIE_SECURE",    "value": "1" },
        { "name": "SEG_QUARANTINE_ROOT",  "value": "/opt/segs/gateway/spool" },
        { "name": "SEG_GMAIL_CREDENTIALS","value": "/opt/segs/credentials.json" },
        { "name": "SEG_GMAIL_DOMAIN",     "value": "pdax.ph" },
        { "name": "SEG_CONTENT_PROVIDER", "value": "glm" },
        { "name": "SEG_INTEL_CLIENT",     "value": "vt_abuseipdb" },
        { "name": "SEG_LANDING_FETCH",    "value": "1" },
        { "name": "SEG_RDAP_LOOKUP",      "value": "1" },
        { "name": "SEG_LLM_TRIAGE",       "value": "1" },
        { "name": "AWS_REGION",           "value": "ap-southeast-1" }
      ],
      "secrets": [
        { "name": "SEG_GMAIL_USERS",             "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:REPLACE_AWS_ACCOUNT_ID:secret:segs/prod:SEG_GMAIL_USERS::" },
        { "name": "SEG_PUBSUB_TOKEN",            "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:REPLACE_AWS_ACCOUNT_ID:secret:segs/prod:SEG_PUBSUB_TOKEN::" },
        { "name": "SEG_GLM_MODEL_ID",            "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:REPLACE_AWS_ACCOUNT_ID:secret:segs/prod:SEG_GLM_MODEL_ID::" },
        { "name": "SEG_GLM_API_KEY",             "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:REPLACE_AWS_ACCOUNT_ID:secret:segs/prod:SEG_GLM_API_KEY::" },
        { "name": "SEG_GLM_PROJECT_ID",          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:REPLACE_AWS_ACCOUNT_ID:secret:segs/prod:SEG_GLM_PROJECT_ID::" },
        { "name": "SEG_GLM_FALLBACK1_MODEL_ID",  "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:REPLACE_AWS_ACCOUNT_ID:secret:segs/prod:SEG_GLM_FALLBACK1_MODEL_ID::" },
        { "name": "SEG_GLM_FALLBACK2_MODEL_ID",  "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:REPLACE_AWS_ACCOUNT_ID:secret:segs/prod:SEG_GLM_FALLBACK2_MODEL_ID::" },
        { "name": "SEG_GLM_FALLBACK2_LOCATION",  "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:REPLACE_AWS_ACCOUNT_ID:secret:segs/prod:SEG_GLM_FALLBACK2_LOCATION::" },
        { "name": "SEG_GLM_FALLBACK3_MODEL_ID",  "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:REPLACE_AWS_ACCOUNT_ID:secret:segs/prod:SEG_GLM_FALLBACK3_MODEL_ID::" },
        { "name": "SEG_GLM_FALLBACK3_LOCATION",  "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:REPLACE_AWS_ACCOUNT_ID:secret:segs/prod:SEG_GLM_FALLBACK3_LOCATION::" },
        { "name": "SEG_VT_API_KEY",              "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:REPLACE_AWS_ACCOUNT_ID:secret:segs/prod:SEG_VT_API_KEY::" },
        { "name": "SEG_ABUSEIPDB_API_KEY",       "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:REPLACE_AWS_ACCOUNT_ID:secret:segs/prod:SEG_ABUSEIPDB_API_KEY::" },
        { "name": "SEGS_NOTIFY_SMTP_PASS",       "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:REPLACE_AWS_ACCOUNT_ID:secret:segs/prod:SEGS_NOTIFY_SMTP_PASS::" },
        { "name": "SEGS_GMAIL_CREDENTIALS_JSON", "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:REPLACE_AWS_ACCOUNT_ID:secret:segs/prod:SEGS_GMAIL_CREDENTIALS_JSON::" }
      ],
      "mountPoints": [
        {
          "sourceVolume": "segs-data",
          "containerPath": "/opt/segs/data",
          "readOnly": false
        },
        {
          "sourceVolume": "segs-spool",
          "containerPath": "/opt/segs/gateway/spool",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/segs/dashboard",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "segs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8765/api/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      }
    }
  ],
  "volumes": [
    {
      "name": "segs-data",
      "efsVolumeConfiguration": {
        "fileSystemId": "REPLACE_EFS_FILESYSTEM_ID",
        "rootDirectory": "/data",
        "transitEncryption": "ENABLED"
      }
    },
    {
      "name": "segs-spool",
      "efsVolumeConfiguration": {
        "fileSystemId": "REPLACE_EFS_FILESYSTEM_ID",
        "rootDirectory": "/spool",
        "transitEncryption": "ENABLED"
      }
    }
  ]
}
